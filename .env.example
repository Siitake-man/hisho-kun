# ============================================
# ネオ秘書くん (Neo-Secretary) 環境設定
# ============================================
# このファイルをコピーして .env にリネームし、
# 実際の値を設定してください。
#
# 必要なもの:
#   1. 任意のLLM APIキー（最低1つ）
#   2.  Google カレンダー連携用 iCal URL（オプション）
# ============================================

# --- デフォルトLLMプロバイダ ---
# 選択肢: opencode / gemini / openai / claude / groq / openrouter / local_gguf / ollama / lm_studio
DEFAULT_LLM_PROVIDER=opencode

# --- 各プロバイダのAPIキー ---
# 必要なプロバイダだけ設定してください
OPENCODE_API_KEY=your-opencode-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- 各プロバイダのデフォルトモデル（オプション） ---
# OPENCODE_MODEL=deepseek-v4-pro
# GEMINI_MODEL=gemini-3.7-flash
# OPENAI_MODEL=gpt-5.6-sol
# CLAUDE_MODEL=claude-fable-5

# --- カスタムOpenAI互換エンドポイント（オプション） ---
# CUSTOM_OPENAI_BASE_URL=http://localhost:8000/v1
# CUSTOM_OPENAI_API_KEY=your-custom-key-here

# --- ローカルLLM（GGUF / 内蔵モデル） ---
# start.bat 初回起動時、または下記コマンドでセットアップすると APIキー不要のオフラインAIが使えます:
#   python tools/setup_local_model.py           (対話式: 350m=推奨・超軽量 / 1.2b=高品質)
# モデル: LFM2.5 (Liquid AI) - LFM Open License v1.0
# LOCAL_GGUF_MODEL=LFM2.5-350M-QAD-Q4_0.gguf

# --- Ollama ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=deepseek-v4:latest

# --- LM Studio ---
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=lfm2.5-2.6b

# --- Google カレンダー iCal 連携 ---
# Googleカレンダーの「秘密のiCalアドレス」を貼り付けてください
# 取得手順: カレンダー設定 → 予定の取得用の秘密のアドレス(iCal) → URLをコピー
# 形式: https://calendar.google.com/calendar/ical/.../basic.ics
# GOOGLE_CALENDAR_ICAL_URL=

# --- 外出先接続 (Tailscale VPN) ---
# TAILSCALE_HOSTNAME=node.tailXXXX.ts.net

# --- ローカル同期サーバーの待受ポート（オプション・P1-4） ---
# 既定は 8765 (sync_config.DEFAULT_SERVER_PORT)。他アプリとポートが競合する場合のみ
# 変更してください。OSの環境変数とこの .env のどちらでも指定できます（OS環境変数が優先）。
# 待受ポート・QRコード表示・Tailscale Serve 自動起動は自動で追従します。
# （※待受ポートは sync_config.SERVER_PORT。設定画面ガイド・Agent Bridge CLI も同値を参照する）
# NEO_HISHO_PORT=8765